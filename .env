# En développement, laisse vide : les requêtes partent en relatif (même origine)
# et passent par le proxy Vite défini dans vite.config.js vers le backend Django.
# En production, mets l'URL réelle de ton API, ex :
# VITE_API_URL=https://api.mon-marche.com
VITE_API_URL=

# Mode démo (données fictives sans backend) : laisser à false en production.
# Mettre à true uniquement pour explorer l'interface sans compte réel.
VITE_ENABLE_DEMO_ADMIN=false
